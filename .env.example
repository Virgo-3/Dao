# This template is documentation. Dao reads process environment variables.
DAO_PROVIDER=demo
# For live AI: set DAO_PROVIDER=openai and your own OPENAI_API_KEY.
OPENAI_API_KEY=
DAO_MODEL=gpt-4.1-mini
DAO_TOKEN_BUDGET=100000
DAO_MAX_OUTPUT_TOKENS=2048
# Optional accounting rates from your provider contract, USD per million tokens.
# Set both to enable cost estimates. Cached-token discounts are not modeled.
# DAO_INPUT_USD_PER_MILLION=
# DAO_OUTPUT_USD_PER_MILLION=
